# OK Tuner environment schema — https://varlock.dev
#
# The tuner itself reads no environment variable. The one secret here is used
# at build time: Vercel builds upload source maps to Sentry with
# SENTRY_AUTH_TOKEN (vite.config.ts), so a stack trace in Sentry names files
# under src/. It lives in a 1Password environment and is loaded through the
# 1Password plugin, so nothing sensitive is stored in Vercel's env vars except
# the service-account token used to reach 1Password. Local values go in
# .env.local (gitignored), which holds only OP_TOKEN and OP_ENV_ID.
#
# No 1Password access? `SKIP_VARLOCK=1 bun run dev` and
# `SKIP_VARLOCK=1 bun run build` leave this file out. Tests, lint and
# typecheck never read it.
#
# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$APP_ENV
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_TOKEN)
# @setValuesBulk(opLoadEnvironment($OP_ENV_ID))
# ---

# Set by Vercel on every build; absent locally. Declared so they are known
# not to be secrets (an undeclared value is treated as sensitive).
# @optional @sensitive=false
VERCEL=
# @optional @sensitive=false
VERCEL_ENV=
# @optional @sensitive=false
VERCEL_GIT_COMMIT_SHA=
# Short-lived token Vercel injects into builds. Never used here; declared as
# sensitive so it is never treated as public.
# @optional
VERCEL_OIDC_TOKEN=

# Which stage this is, and the value forEnv() tests.
# @type=enum(development, preview, production) @sensitive=false
APP_ENV=fallback($VERCEL_ENV, development)

# 1Password service-account token. A Vercel env var for preview and
# production, .env.local for development.
# @type=opServiceAccountToken @internal
OP_TOKEN=

# ID of the 1Password environment that supplies the values below. One
# environment serves every stage: the only secret is the same for all of them.
# @sensitive=false @internal
OP_ENV_ID=

# Sentry — https://sentry.io — organization token that uploads source maps
# (project ok-tuner in lightning-jar). Build-time only; it is never in the
# built files. Required on Vercel so a build without it fails, instead of
# shipping stack traces nobody can read. Local builds never upload.
# @required=forEnv(preview, production)
SENTRY_AUTH_TOKEN=
