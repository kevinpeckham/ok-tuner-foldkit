{
  "name": "ok-tuner-foldkit",
  "version": "0.3.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && mv dist/client/404/index.html dist/client/404.html && rmdir dist/client/404",
    "preview": "vite preview --outDir dist/client",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "test": "vitest run",
    "lint": "oxlint src && effect-tsgo patch --no-typescript --oxlint && oxlint --config .oxlintrc.effect.json --deny-warnings src"
  },
  "dependencies": {
    "@effect/platform-browser": "4.1.0",
    "@foldkit/ui": "0.170.0",
    "@sentry/browser": "11.14.0",
    "@vercel/analytics": "2.0.1",
    "effect": "4.1.0",
    "foldkit": "0.170.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.50.0",
    "@foldkit/devtools": "0.170.0",
    "@foldkit/devtools-mcp": "0.26.0",
    "@foldkit/oxlint-plugin": "0.15.4",
    "@foldkit/vite-plugin": "0.29.0",
    "@sentry/vite-plugin": "11.16.0",
    "@tailwindcss/vite": "^4.3.3",
    "@varlock/1password-plugin": "2.0.7",
    "@varlock/vite-integration": "1.5.6",
    "happy-dom": "^20.14.5",
    "oxfmt": "^0.66.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "varlock": "1.25.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
